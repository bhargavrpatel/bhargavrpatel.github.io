<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
        <title>{{ site.name }}</title>

        <link rel="stylesheet" href="/assets/css/normalize.css">
        <link rel="stylesheet" href="/assets/css/gridism.css">
        <link rel="stylesheet" href="/assets/css/style.css">

        {% if site.authorName %}
            <meta name="author" content="{{ site.authorName }}">
        {% endif %}

        {% if site.description %}
            <meta name="description" content="{{ site.description }}">
        {% endif %}
    </head>
    <body class="wrap wider">
        {% include "header.njk" %}


        <section>
            <div class="grid whole unit">
                {{ content | safe }}
            </div>
        </section>

        {% include "footer.njk" %}

        {% if site.goatcounterURL %}
            <script data-goatcounter="{{ site.goatcounterURL }}" async src="https://gc.zgo.at/count.js"></script>
        {% endif %}      
    </body>
</html>